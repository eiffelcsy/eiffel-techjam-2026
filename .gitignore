# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
.DS_Store

# Generated/output directories, shared by every stage. Reproducible from a
# config plus a manifest/checkpoint sha (see train/cache/spec.py) -- not
# something to commit, and each is potentially large.
#
# LEADING SLASH IS LOAD-BEARING on the ones with a common basename component:
# unanchored, e.g. `logs/` would match a `logs/` directory at any depth and
# could silently exclude source files that happen to sit under one.
/data/
/cache_ms/
/cache_ms_val/
/checkpoints/
/results/*
!/results/.gitkeep
/logs/
/wandb/
